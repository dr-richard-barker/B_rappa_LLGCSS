    given-names: Richard
    orcid: "https://orcid.org/0000-0001-5681-9857"
  - family-names: O'Rourke
    given-names: Aubry
license: CC0-1.0
repository-code: "https://github.com/dr-richard-barker/B_rappa_LLGCSS"
keywords:
  - Brassica rapa
  - RNA-seq
  - space radiation
  - galactic cosmic rays
  - redox kinetics
  - variational autoencoder
  - Lunar LEAF
  - transcriptomics
  - DESeq2
  - fixative fidelity
